# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form (Resend) ───────────────────────────────────────────────────
# Create an API key at https://resend.com — without it, submissions are logged
# to the server console instead of being emailed.
RESEND_API_KEY=
# Where contact-form emails are delivered
CONTACT_TO_EMAIL=hello@example.com

# ── GitHub stats ────────────────────────────────────────────────────────────
# Used by the GitHub section. Wrong/missing values gracefully fall back to
# placeholder stats.
GITHUB_USERNAME=your-github-username
